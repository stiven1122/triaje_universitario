# ---------- n8n ----------
# URL del webhook del workflow 2 (Respuestas administrativas).
# Pruebas:     http://localhost:5678/webhook-test/triaje/respuesta
# Producción:  http://localhost:5678/webhook/triaje/respuesta   (workflow activado)
N8N_WEBHOOK_URL=https://triaje.app.n8n.cloud/webhook/triaje/respuesta
# Mismo valor que pongas en la credencial "Header Auth" del Webhook en n8n
# (nombre del header: x-webhook-secret)
N8N_WEBHOOK_SECRET=cambia-este-secreto-largo
N8N_TIMEOUT_MS=30000
